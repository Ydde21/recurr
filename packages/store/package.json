{
  "name": "@recurr-dev/store",
  "version": "0.1.1",
  "description": "Recurr incident storage \u2014 filesystem + PostgreSQL backends",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "recurr",
    "incident",
    "replay",
    "debugging",
    "storage",
    "postgres"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "migrations"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "dev": "tsc -p tsconfig.json --watch"
  },
  "dependencies": {
    "@recurr-dev/core": "workspace:*",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/pg": "^8.11.10",
    "typescript": "^7.0.2",
    "vitest": "^2.1.8"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Ydde21/recurr.git",
    "directory": "packages/store"
  },
  "homepage": "https://github.com/Ydde21/recurr#readme",
  "bugs": "https://github.com/Ydde21/recurr/issues"
}
