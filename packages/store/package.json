{
  "name": "@recurr/store",
  "version": "0.1.0",
  "description": "Recurr incident storage — filesystem + PostgreSQL backends",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "recurr",
    "incident",
    "replay",
    "debugging",
    "storage",
    "postgres"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "migrations"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "dev": "tsc -p tsconfig.json --watch"
  },
  "dependencies": {
    "@recurr/core": "workspace:*",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/pg": "^8.11.10",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
