{
  "name": "@recurr/server",
  "version": "0.1.0",
  "description": "Recurr collector & query API — ingests execution records and serves them to the CLI",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "recurr-server": "dist/bin.js"
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "dev": "tsc -p tsconfig.json --watch",
    "start": "node dist/bin.js"
  },
  "dependencies": {
    "@recurr/core": "workspace:*",
    "@recurr/store": "workspace:*",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
