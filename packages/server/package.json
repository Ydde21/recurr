{
  "name": "@recurr-dev/server",
  "version": "0.1.1",
  "description": "Recurr collector, query API + developer UI server \u2014 ingests execution records and serves the debugging workspace",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "recurr",
    "incident",
    "replay",
    "debugging",
    "collector",
    "api",
    "server"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "recurr-server": "dist/bin.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "dev": "tsc -p tsconfig.json --watch",
    "start": "node dist/bin.js"
  },
  "dependencies": {
    "@recurr-dev/core": "workspace:*",
    "@recurr-dev/replay": "workspace:*",
    "@recurr-dev/store": "workspace:*",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "typescript": "^5.7.2",
    "vitest": "^5.0.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Ydde21/recurr.git",
    "directory": "packages/server"
  },
  "homepage": "https://github.com/Ydde21/recurr#readme",
  "bugs": "https://github.com/Ydde21/recurr/issues"
}
