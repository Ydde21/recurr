{
  "name": "@recurr-dev/replay",
  "version": "0.1.2",
  "description": "Recurr replay engine \u2014 reconstructs captured executions in an isolated child process",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "recurr",
    "incident",
    "replay",
    "debugging",
    "isolation",
    "deterministic"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && cp src/*.mjs dist/",
    "test": "vitest run",
    "dev": "tsc -p tsconfig.json --watch"
  },
  "dependencies": {
    "@recurr-dev/core": "workspace:*",
    "@recurr-dev/store": "workspace:*"
  },
  "devDependencies": {
    "@recurr-dev/sdk": "workspace:*",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Ydde21/recurr.git",
    "directory": "packages/replay"
  },
  "homepage": "https://github.com/Ydde21/recurr#readme",
  "bugs": "https://github.com/Ydde21/recurr/issues"
}
