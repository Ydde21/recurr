{
  "name": "@recurr/replay",
  "version": "0.1.0",
  "description": "Recurr replay engine — reconstructs captured executions in an isolated child process",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "recurr",
    "incident",
    "replay",
    "debugging",
    "isolation",
    "deterministic"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && cp src/*.mjs dist/",
    "test": "vitest run",
    "dev": "tsc -p tsconfig.json --watch"
  },
  "dependencies": {
    "@recurr/core": "workspace:*",
    "@recurr/store": "workspace:*"
  },
  "devDependencies": {
    "@recurr/sdk": "workspace:*",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
