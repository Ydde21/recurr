{
  "name": "@recurr-dev/core",
  "version": "0.1.1",
  "description": "Recurr incident record schema, redaction, and execution diff engine",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "recurr",
    "incident",
    "replay",
    "debugging",
    "schema",
    "redaction",
    "diff"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "default": "./dist/types.js"
    },
    "./diff": {
      "types": "./dist/diff.d.ts",
      "default": "./dist/diff.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "dev": "tsc -p tsconfig.json --watch"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "vitest": "^5.0.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Ydde21/recurr.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/Ydde21/recurr#readme",
  "bugs": "https://github.com/Ydde21/recurr/issues"
}
