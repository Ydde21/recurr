{
  "name": "@recurr-dev/cli",
  "version": "0.1.3",
  "description": "Recurr CLI \u2014 inspect, replay, diff and regression-test production incidents",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "recurr",
    "incident",
    "replay",
    "debugging",
    "cli",
    "devtools",
    "production"
  ],
  "type": "module",
  "bin": {
    "recurr": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "dev": "tsc -p tsconfig.json --watch"
  },
  "dependencies": {
    "@recurr-dev/core": "workspace:*",
    "@recurr-dev/replay": "workspace:*",
    "@recurr-dev/store": "workspace:*",
    "commander": "^12.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Ydde21/recurr.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/Ydde21/recurr#readme",
  "bugs": "https://github.com/Ydde21/recurr/issues",
  "publishConfig": {
    "access": "public"
  }
}
