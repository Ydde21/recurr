# Minimal image for the recurr collector/API server.
FROM node:22-alpine AS build
RUN corepack enable && corepack prepare pnpm@9.15.9 --activate
WORKDIR /app
COPY pnpm-workspace.yaml package.json pnpm-lock.yaml tsconfig.base.json turbo.json ./
COPY packages/core ./packages/core
COPY packages/store ./packages/store
COPY packages/server ./packages/server
RUN pnpm install --filter @recurr/server... --frozen-lockfile || pnpm install --filter @recurr/server...
RUN pnpm --filter @recurr/server... build

FROM node:22-alpine
RUN corepack enable && corepack prepare pnpm@9.15.9 --activate
WORKDIR /app
COPY --from=build /app .
ENV NODE_ENV=production
EXPOSE 4780
CMD ["node", "packages/server/dist/bin.js"]
